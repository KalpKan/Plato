{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . \":(exclude)docs\" \":(exclude)scripts\" \":(exclude)STATUS.md\" \":(exclude)*.md\"",
  "functions": {
    "src/app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,docs/**,figma landingpage/**,legacy/**,course_outlines/**,test_*.py,*.md,.venv/**,setup.py,package.json,uploads/**,temp_calendars/**}"
    }
  }
}
