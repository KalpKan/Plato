# Copy to .env for local runs (never commit .env). Names only; real values live in Vercel.
SECRET_KEY=            # required. Any long random string; signs the session cookie.
DATABASE_URL=          # optional locally (SQLite is used when empty). Production: Neon pooled Postgres URL.
POSTHOG_API_KEY=       # optional. Public PostHog project key (phc_...). Empty = analytics off.
POSTHOG_HOST=          # optional. Server-side ingest host, default https://us.i.posthog.com
POSTHOG_UI_HOST=       # optional. PostHog UI host for the browser snippet, default https://us.posthog.com
PLATO_TMP_DIR=         # optional. Scratch dir for uploads, default /tmp
